  "eventsFunctions": [
    {
      "fullName": "",
      "functionType": "Action",
      "name": "UploadBase64ToSprite",
      "sentence": "",
      "events": [
        {
          "type": "BuiltinCommonInstructions::JsCode",
          "inlineCode": [
            "// 1. Link GDevelop Parameters to JavaScript",
            "const objects = eventsFunctionContext.getObjects(\"MySprite\");",
            "const base64 = eventsFunctionContext.getArgument(\"Base64\");",
            "const modifySize = eventsFunctionContext.getArgument(\"ModifySize\");",
            "",
            "// Safety check: If no object is selected in the event sheet, do nothing.",
            "if (objects.length === 0 || !base64) return;",
            "",
            "// 2. Setup Persistent Cache",
            "if (!gdjs._ExtensionUploadedImages) {",
            "  gdjs._ExtensionUploadedImages = new Map();",
            "}",
            "",
            "const oldWidth  = objects[0].getWidth();",
            "const oldHeight = objects[0].getHeight();",
            "",
            "// 3. Helper function to load image safely for Safari/Chrome",
            "function loadImage(base64Data) {",
            "  return new Promise((resolve, reject) => {",
            "    // Reuse texture if already uploaded",
            "    if (gdjs._ExtensionUploadedImages.has(base64Data)) {",
            "      resolve(gdjs._ExtensionUploadedImages.get(base64Data));",
            "      return;",
            "    }",
            "",
            "    const img = new Image();",
            "    img.onload = () => {",
            "      // Draw to canvas to prevent \"Tainted Canvas\" errors in Safari",
            "      const canvas  = document.createElement(\"canvas\");",
            "      canvas.width  = img.naturalWidth;",
            "      canvas.height = img.naturalHeight;",
            "      canvas.getContext(\"2d\").drawImage(img, 0, 0);",
            "",
            "      const newTexture = PIXI.Texture.from(canvas);",
            "      ",
            "      const data = [newTexture, img.naturalWidth, img.naturalHeight];",
            "      gdjs._ExtensionUploadedImages.set(base64Data, data);",
            "      resolve(data);",
            "    };",
            "    img.onerror = () => reject(new Error(\"Failed to load image\"));",
            "    img.src = base64Data;",
            "  });",
            "}",
            "",
            "// 4. Execution",
            "loadImage(base64)",
            "  .then(([newTexture, texWidth, texHeight]) => {",
            "    // Apply texture to the Sprite",
            "    const rendererObj = objects[0].getRendererObject();",
            "    if (rendererObj) {",
            "      rendererObj.texture = newTexture;",
            "      newTexture.baseTexture.update(); // Force Safari refresh",
            "    }",
            "",
            "    // Handle Resizing",
            "    if (modifySize) {",
            "      objects[0].setWidth(texWidth);",
            "      objects[0].setHeight(texHeight);",
            "    } else {",
            "      objects[0].setWidth(oldWidth);",
            "      objects[0].setHeight(oldHeight);",
            "    }",
            "",
            "    // Save dimensions to GDevelop Variables (Parameter #4 and #5)",
            "    const wVar = eventsFunctionContext.getArgument(\"ImageWidth\");",
            "    const hVar = eventsFunctionContext.getArgument(\"ImageHeight\");",
            "    if (wVar) wVar.setNumber(texWidth);",
            "    if (hVar) hVar.setNumber(texHeight);",
            "",
            "  })",
            "  .catch((error) => {",
            "    console.error(\"[WebImageTools] Upload failed:\", error);",
            "  });"
          ],
          "parameterObjects": "",
          "useStrict": true,
          "eventsSheetExpanded": false
        }
      ],
      "parameters": [
        {
          "description": "Target Sprite Object",
          "name": "MySprite",
          "supplementaryInformation": "Sprite",
          "type": "objectList"
        },
        {
          "description": "Base64 Image Data",
          "name": "Base64",
          "type": "string"
        },
        {
          "description": "Adjust Sprite size to image?",
          "name": "ModifySize",
          "type": "yesorno"
        },
        {
          "description": "Var to save width",
          "name": "ImageWidth",
          "type": "variable"
        },
        {
          "description": "Var to save height",
          "name": "ImageHeight",
          "type": "variable"
        }
      ],
      "objectGroups": []
    },
    {
      "fullName": "",
      "functionType": "Action",
      "name": "DownloadSpriteAsPNG",
      "sentence": "",
      "events": [
        {
          "type": "BuiltinCommonInstructions::JsCode",
          "inlineCode": [
            "// 1. Link GDevelop Parameters",
            "const objects = eventsFunctionContext.getObjects(\"MySprite\");",
            "const fileName = eventsFunctionContext.getArgument(\"FileName\") || \"download\";",
            "",
            "// Safety check: Ensure we have a sprite to work with",
            "if (objects.length === 0) return;",
            "",
            "const sprite = objects[0].getRendererObject();",
            "",
            "// 2. Helper: Get the Canvas source (The Safari-Safe Way)",
            "function getSpriteCanvas(spriteObj) {",
            "  const bt = spriteObj.texture && spriteObj.texture.baseTexture;",
            "",
            "  // If it's a texture we uploaded (Canvas-backed)",
            "  if (bt && bt.resource && bt.resource.source instanceof HTMLCanvasElement) {",
            "    return bt.resource.source;",
            "  }",
            "",
            "  // If it's a standard GDevelop asset (Image-backed)",
            "  if (bt && bt.resource && (bt.resource.source instanceof HTMLImageElement || bt.resource.source instanceof Image)) {",
            "    const c = document.createElement(\"canvas\");",
            "    c.width = bt.realWidth;",
            "    c.height = bt.realHeight;",
            "    c.getContext(\"2d\").drawImage(bt.resource.source, 0, 0);",
            "    return c;",
            "  }",
            "",
            "  // Fallback for complex WebGL cases (May fail on Safari)",
            "  const renderer = runtimeScene.getGame().getRenderer().getPIXIRenderer();",
            "  return renderer.extract.canvas(spriteObj);",
            "}",
            "",
            "// 3. Helper: Safari Detection",
            "function isSafari() {",
            "  return /Safari/.test(navigator.userAgent) && !/Chrome|Chromium/.test(navigator.userAgent);",
            "}",
            "",
            "// 4. Execution",
            "try {",
            "  const sourceCanvas = getSpriteCanvas(sprite);",
            "",
            "  sourceCanvas.toBlob((blob) => {",
            "    if (!blob) {",
            "      console.error(\"[WebImageTools] Could not generate blob.\");",
            "      return;",
            "    }",
            "",
            "    const blobUrl = URL.createObjectURL(blob);",
            "",
            "    if (isSafari()) {",
            "      // Safari: Opens in new tab, user saves manually (Cmd+S or Long-press)",
            "      const newTab = window.open(blobUrl, \"_blank\");",
            "      if (!newTab) alert(\"Please allow popups to download images on Safari.\");",
            "      ",
            "      // Cleanup after 60s",
            "      setTimeout(() => URL.revokeObjectURL(blobUrl), 60000);",
            "    } else {",
            "      // Chrome/Firefox: Standard automatic download",
            "      const a = document.createElement(\"a\");",
            "      a.href = blobUrl;",
            "      a.download = fileName.endsWith(\".png\") ? fileName : fileName + \".png\";",
            "      document.body.appendChild(a);",
            "      a.click();",
            "      document.body.removeChild(a);",
            "      ",
            "      // Cleanup after 1s",
            "      setTimeout(() => URL.revokeObjectURL(blobUrl), 1000);",
            "    }",
            "  }, \"image/png\");",
            "",
            "} catch (err) {",
            "  console.error(\"[WebImageTools] Download failed:\", err);",
            "}"
          ],
          "parameterObjects": "",
          "useStrict": true,
          "eventsSheetExpanded": false
        }
      ],
      "parameters": [
        {
          "description": "Target Sprite to Download",
          "name": "MySprite",
          "supplementaryInformation": "Sprite",
          "type": "objectList"
        },
        {
          "description": "Save File As...",
          "name": "FileName",
          "type": "string"
        }
      ],
      "objectGroups": []
    },
    {
      "fullName": "",
      "functionType": "Action",
      "name": "OpenFilePicker",
      "sentence": "",
      "events": [
        {
          "type": "BuiltinCommonInstructions::JsCode",
          "inlineCode": [
            "const variableName = eventsFunctionContext.getArgument(\"OutputVariable\");",
            "const scene = runtimeScene;",
            "",
            "// 1. Create a hidden file input element",
            "const input = document.createElement('input');",
            "input.type = 'file';",
            "input.accept = 'image/*'; // Only allow images",
            "",
            "input.onchange = (event) => {",
            "    const file = event.target.files[0];",
            "    if (!file) return;",
            "",
            "    const reader = new FileReader();",
            "    ",
            "    reader.onload = (e) => {",
            "        const base64String = e.target.result;",
            "        ",
            "        // 2. Save the Base64 string into the GDevelop Scene Variable",
            "        scene.getVariables().get(variableName).setString(base64String);",
            "        ",
            "        // 3. Set a \"Status\" variable so GDevelop knows the file is ready",
            "        scene.getVariables().get(\"IsFileReady\").setBoolean(true);",
            "    };",
            "",
            "    reader.readAsDataURL(file);",
            "};",
            "",
            "// 4. Programmatically click it",
            "input.click();"
          ],
          "parameterObjects": "",
          "useStrict": true,
          "eventsSheetExpanded": false
        }
      ],
      "parameters": [
        {
          "description": "Name of the Scene Variable to save the Base64 string into.",
          "name": "OutputVariable",
          "type": "string"
        }
      ],
      "objectGroups": []
    }
