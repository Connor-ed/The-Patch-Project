    {
      "fullName": "FetchSingleRow",
      "functionType": "Action",
      "group": "Supabase",
      "name": "FetchSingleRow",
      "sentence": "Fetch single row from _PARAM3_ where _PARAM4_ = _PARAM5_ and store result in variable _PARAM6_",
      "events": [
        {
          "type": "BuiltinCommonInstructions::JsCode",
          "inlineCode": [
            "const url = eventsFunctionContext.getArgument(\"supabase_url\");",
            "const key = eventsFunctionContext.getArgument(\"supabase_key\");",
            "const table = eventsFunctionContext.getArgument(\"table_name\");",
            "const idCol = eventsFunctionContext.getArgument(\"id_column\");",
            "const idVal = eventsFunctionContext.getArgument(\"id_value\");",
            "const outputVarName = eventsFunctionContext.getArgument(\"output_variable\");",
            "",
            "const fullUrl = `${url}/rest/v1/${table}?${encodeURIComponent(idCol)}=eq.${encodeURIComponent(idVal)}&select=*`;",
            "",
            "eventsFunctionContext.task = new gdjs.PromiseTask(",
            "  fetch(fullUrl, {",
            "    method: \"GET\",",
            "    headers: {",
            "      \"apikey\": key,",
            "      \"Authorization\": `Bearer ${key}`,",
            "      \"Content-Type\": \"application/json\"",
            "    }",
            "  })",
            "  .then(r => r.json())",
            "  .then(data => {",
            "    runtimeScene.getVariables().get(outputVarName).setString(JSON.stringify(data));",
            "  })",
            "  .catch(e => {",
            "    const err = runtimeScene.getVariables().get(outputVarName + \"_error\");",
            "    if (err) err.setString(e.message);",
            "  })",
            ");"
          ],
          "parameterObjects": "",
          "useStrict": true,
          "eventsSheetExpanded": false
        }
