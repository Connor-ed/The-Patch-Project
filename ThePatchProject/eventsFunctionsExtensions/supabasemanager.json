    {
      "fullName": "FetchTableData",
      "functionType": "Action",
      "group": "Supabase",
      "name": "FetchTableData",
      "sentence": "Fetch table _PARAM3_ from Supabase with query _PARAM4_ and store result in variable _PARAM5_",
      "events": [
        {
          "type": "BuiltinCommonInstructions::JsCode",
          "inlineCode": [
            "const url = eventsFunctionContext.getArgument(\"supabase_url\");",
            "const key = eventsFunctionContext.getArgument(\"supabase_key\");",
            "const table = eventsFunctionContext.getArgument(\"table_name\");",
            "const query = eventsFunctionContext.getArgument(\"query_params\");",
            "const outputVarName = eventsFunctionContext.getArgument(\"output_variable\");",
            "",
            "const fullUrl = `${url}/rest/v1/${table}?${query}`;",
            "",
            "eventsFunctionContext.task = new gdjs.PromiseTask(",
            "  fetch(fullUrl, {",
            "    method: \"GET\",",
            "    headers: {",
            "      \"apikey\": key,",
            "      \"Authorization\": `Bearer ${key}`,",
            "      \"Content-Type\": \"application/json\",",
            "      \"Prefer\": \"return=representation\"",
            "    }",
            "  })",
            "  .then(response => {",
            "    if (!response.ok) throw new Error(`HTTP ${response.status}`);",
            "    return response.json();",
            "  })",
            "  .then(data => {",
            "    const variable = runtimeScene.getVariables().get(outputVarName);",
            "    variable.setString(JSON.stringify(data));",
            "  })",
            "  .catch(error => {",
            "    const errorVar = runtimeScene.getVariables().get(outputVarName + \"_error\");",
            "    if (errorVar) errorVar.setString(error.message);",
            "  })",
            ");"
          ],
          "parameterObjects": "",
          "useStrict": true,
          "eventsSheetExpanded": false
        }
      ],
      "parameters": [
        {
          "description": "",
          "name": "supabase_url",
          "type": "string"
        },
        {
          "description": "",
          "name": "supabase_key",
          "type": "string"
        },
        {
          "description": "",
          "name": "table_name",
          "type": "string"
        },
        {
          "description": "",
          "name": "query_params",
          "type": "string"
        },
        {
          "description": "",
          "name": "output_variable",
          "type": "string"
        }
      ],
      "objectGroups": []
