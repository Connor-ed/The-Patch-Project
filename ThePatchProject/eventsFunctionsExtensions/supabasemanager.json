    {
      "fullName": "GetStorageURL",
      "functionType": "Action",
      "group": "Supabase",
      "name": "GetStorageURL",
      "sentence": "Get public storage URL for bucket _PARAM2_ file _PARAM3_ and store in variable _PARAM4_",
      "events": [
        {
          "type": "BuiltinCommonInstructions::JsCode",
          "inlineCode": [
            "const url = eventsFunctionContext.getArgument(\"supabase_url\");",
            "const bucket = eventsFunctionContext.getArgument(\"bucket\");",
            "const path = eventsFunctionContext.getArgument(\"file_path\");",
            "const outputVarName = eventsFunctionContext.getArgument(\"output_variable\");",
            "",
            "const publicUrl = `${url}/storage/v1/object/public/${bucket}/${encodeURIComponent(path)}`;",
            "const variable = runtimeScene.getVariables().get(outputVarName);",
            "variable.setString(publicUrl);"
          ],
          "parameterObjects": "",
          "useStrict": true,
          "eventsSheetExpanded": false
        }
      ],
      "parameters": [
        {
