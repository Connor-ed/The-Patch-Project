  "iconUrl": "data:image/svg+xml;base64,",
  "name": "AutoActivateUI",
  "previewIconUrl": "https://asset-resources.gdevelop.io/public-resources/Icons/1475943ef78ff0dadf733b21cf46630fd2f0f724668e3a30d17e45799c8d72fd_card-off-outline.svg",
  "shortDescription": "Automatically enables or disables 2D UI objects like buttons and sliders based on their visibility.",
  "version": "1.1.0",
  "description": [
    "This extension provides a set of behaviors for 2D UI objects to automatically manage their interactive state based on actual visibility on screen.",
    "When a 2D UI object isn't being rendered (based on the Pixi renderer's 'worldVisible' property), its corresponding behavior will deactivate interactions, preventing accidental clicks or inputs. The interactions are automatically re-activated when the object is visible again.",
    "",
    "This extension also provides the \"Is actually visible on screen\" condition, which can be used separately in your events.",
    "",
    "**Included Behaviors:**",
    "Auto activate button (panel sprite)",
    "Auto activate toggle switch",
    "Auto activate slider",
    "Auto activate button states behavior",
    "",
    "**Included Conditions:**",
    "Is actually visible on screen"
  ],
  "tags": [
    "ui",
    "interface",
    "visibility",
    "interaction",
    "automatic",
    "button",
    "slider",
    "toggle"
  ],
  "authorIds": [
    "zZ9yI6twumVyDYIudFPzHAotOeA2"
  ],
  "dependencies": [],
  "globalVariables": [],
  "sceneVariables": [],
  "eventsFunctions": [
    {
      "description": "For 2D objects, check if the object is truly rendered on screen. This verifies the renderer's 'worldVisible' property, which also accounts for parent or layer visibility.",
      "fullName": "Is actually visible on screen",
      "functionType": "Condition",
      "name": "IsActuallyVisibleOnScreen",
      "sentence": "_PARAM1_ is actually visible on screen",
      "events": [
        {
          "type": "BuiltinCommonInstructions::JsCode",
          "inlineCode": [
            "const object = objects[0];",
            "const pixiObject = object.getRendererObject();",
            "if (!object) {",
            "    eventsFunctionContext.returnValue = false;",
            "} else if (!pixiObject) {",
            "    eventsFunctionContext.returnValue = false;",
            "} else {",
            "    eventsFunctionContext.returnValue = pixiObject.worldVisible;",
            "}"
          ],
          "parameterObjects": "Object",
          "useStrict": true,
          "eventsSheetExpanded": false
        }
      ],
      "parameters": [
        {
          "description": "",
          "name": "Object",
          "type": "objectList"
        }
      ],
      "objectGroups": []
    }
  ],
  "eventsFunctionsFolderStructure": {
    "folderName": "__ROOT",
    "children": [
      {
        "functionName": "IsActuallyVisibleOnScreen"
      }
    ]
  },
