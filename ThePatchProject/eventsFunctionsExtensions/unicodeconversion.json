  "eventsFunctions": [
    {
      "description": "Reverses the unicode of a string with a base.",
      "fullName": "Reverse the unicode of a string",
      "functionType": "StringExpression",
      "name": "ReverseUnicode",
      "sentence": "",
      "events": [
        {
          "type": "BuiltinCommonInstructions::JsCode",
          "inlineCode": [
            "const convString = eventsFunctionContext.getArgument(\"String\");",
            "const convBase = eventsFunctionContext.getArgument(\"Base\");",
            "const convRange = eventsFunctionContext.getArgument(\"Range\");",
            "",
            "//This gets the decimal unicode and turns it into the desired base",
            "let result = convString.split(\"\").map(function (char) {",
            "  return char.charCodeAt(0).toString(convBase).padStart(convRange, \"0\");",
            "}).join(\" \");",
            "",
            "//This reverses the unicode representation",
            "const joinArray = result.split(\"\").reverse().join(\"\");",
            "",
            "//This turns the unicode representation into the decimal unicode representation ",
            "//and turns it into the string using the fromCharCode function",
            "result = \"\";",
            "joinArray.split(\" \").map(function (bin) {",
            "  result += String.fromCharCode(parseInt(bin, convBase));",
            "});",
            "",
            "eventsFunctionContext.returnValue = result;"
          ],
          "parameterObjects": "",
          "useStrict": true,
          "eventsSheetExpanded": true
        }
      ],
      "expressionType": {
        "type": "string"
      },
      "parameters": [
        {
          "description": "String to reverse",
          "name": "String",
          "type": "string"
        },
        {
          "description": "Base of the reverse (Default: 2)",
          "name": "Base",
          "type": "expression"
        },
        {
          "description": "Range of unicode characters (Put 16 here to support the most characters if you put 2 in the base)",
          "name": "Range",
          "type": "expression"
        }
      ],
      "objectGroups": []
    },
    {
      "description": "Converts a unicode representation into String with a base.",
      "fullName": "Unicode to string",
      "functionType": "StringExpression",
      "name": "UnicodeToText",
      "sentence": "",
      "events": [
        {
          "type": "BuiltinCommonInstructions::JsCode",
          "inlineCode": [
            "const convString = eventsFunctionContext.getArgument(\"String\");",
            "const convBase = eventsFunctionContext.getArgument(\"Base\");",
            "let sep = eventsFunctionContext.getArgument(\"Sep\");",
            "",
            "//Checks if the Sperator text is empty. If it is , this sets the value of the sep variable with \" \"",
            "if (sep == \"\") {",
            "  sep = \" \";",
            "};",
            "",
            "let result = \"\";",
            "",
            "//This turns the unicode representation into decimal unicode representation and turns it into the string using the fromCharCode function",
            "convString.split(sep).map(function (bin) {",
            "  result += String.fromCharCode(parseInt(bin, convBase));",
            "});",
            "",
            "eventsFunctionContext.returnValue = result;",
            ""
          ],
          "parameterObjects": "",
          "useStrict": true,
          "eventsSheetExpanded": true
        }
      ],
      "expressionType": {
        "type": "string"
      },
      "parameters": [
        {
          "description": "The unicode to convert to String",
          "name": "String",
          "type": "string"
        },
        {
          "description": "Base",
          "name": "Base",
          "type": "expression"
        },
        {
          "description": "Seperator text (Optional)",
          "name": "Sep",
          "type": "string"
        }
      ],
      "objectGroups": []
    },
    {
      "description": "Converts a string into unicode representation with a base.",
      "fullName": "String to unicode conversion",
      "functionType": "StringExpression",
      "name": "TextToUnicode",
      "sentence": "",
      "events": [
        {
          "type": "BuiltinCommonInstructions::JsCode",
          "inlineCode": [
            "const convString = eventsFunctionContext.getArgument(\"String\");",
            "const convBase = eventsFunctionContext.getArgument(\"Base\");",
            "let sep = eventsFunctionContext.getArgument(\"Sep\");",
            "",
            "//Checks if the Sperator text is empty. If it is , this sets the value of the sep variable with \" \"",
            "if (sep == \"\") {",
            "  sep = \" \";",
            "};",
            "",
            "//This gets the decimal code and turns it into the desired base",
            "const result = convString.split('').map(function (char) {",
            "  return char.charCodeAt(0).toString(convBase);",
            "}).join(sep);",
            "",
            "eventsFunctionContext.returnValue = result;",
            ""
          ],
          "parameterObjects": "",
          "useStrict": true,
          "eventsSheetExpanded": true
        }
      ],
